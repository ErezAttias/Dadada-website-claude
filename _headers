# Version 9: optimised media rarely changes, so browsers may keep it for a week;
# CSS and JS are versioned with ?v= in index.html, so they can be kept longer.
/9/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/9/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/9/css/*
  Cache-Control: public, max-age=2592000
/9/js/*
  Cache-Control: public, max-age=2592000
